DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
ENVIRONMENT=development
SESSION_COOKIE_NAME=chronos_session
SESSION_TTL_SECONDS=28800
SESSION_COOKIE_SECURE=false
TRUSTED_HOSTS=["localhost","127.0.0.1"]
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
# Client addresses the API answers. Keep the loopback entries when adding a
# LAN subnet, e.g. ["127.0.0.0/8","::1/128","192.168.1.0/24"].
ALLOWED_CLIENT_NETWORKS=["127.0.0.0/8","::1/128"]
# Local development operational defaults; override after deployment testing.
JOB_POLL_INTERVAL_SECONDS=1
JOB_LEASE_SECONDS=30
JOB_HEARTBEAT_INTERVAL_SECONDS=5
JOB_TERMINATION_GRACE_SECONDS=5
JOB_MAX_ATTEMPTS=3
JOB_GA_TIMEOUT_SECONDS=600
JOB_ARM_TIMEOUT_SECONDS=300
JOB_EVALUATION_TIMEOUT_SECONDS=12000
